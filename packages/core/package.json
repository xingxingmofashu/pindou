{
  "name": "@pindou/core",
  "version": "0.1.0",
  "description": "Framework-agnostic business logic for pindou: editor/export/transform, i18n, and React hooks shared by the web and desktop apps",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./date": "./src/date.ts",
    "./editor": "./src/editor.ts",
    "./export": "./src/export.ts",
    "./transform": "./src/transform.ts",
    "./utils": "./src/utils.ts",
    "./i18n/config": "./src/i18n/config.ts",
    "./i18n/client": "./src/i18n/client.tsx",
    "./i18n/types": "./src/i18n/types.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./server/*": "./src/server/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@pindou/shared": "workspace:*",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.2",
    "pixi.js": "^8.8.1",
    "sharp": "^0.34.4",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}