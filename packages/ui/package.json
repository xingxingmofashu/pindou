{
  "name": "@pindou/ui",
  "version": "0.1.0",
  "description": "Shared UI primitives (Base UI + Tailwind) for the pindou web + desktop apps",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "style": "./src/index.css",
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils.ts",
    "./components/*": "./src/components/*.tsx",
    "./pages/*": "./src/pages/*.tsx",
    "./index.css": "./src/index.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "culori": "^4.0.2",
    "lucide-react": "^1.27.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "@pindou/core": "workspace:*",
    "@pindou/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4"
  }
}
