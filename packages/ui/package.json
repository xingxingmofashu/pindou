{
  "name": "@pindou/ui",
  "version": "0.1.0",
  "description": "Shared UI primitives (Base UI + Tailwind) for the pindou web + desktop apps",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alert-dialog": "./src/components/ui/alert-dialog.tsx",
    "./button": "./src/components/ui/button.tsx",
    "./card": "./src/components/ui/card.tsx",
    "./checkbox": "./src/components/ui/checkbox.tsx",
    "./collapsible": "./src/components/ui/collapsible.tsx",
    "./dialog": "./src/components/ui/dialog.tsx",
    "./dropdown-menu": "./src/components/ui/dropdown-menu.tsx",
    "./input": "./src/components/ui/input.tsx",
    "./label": "./src/components/ui/label.tsx",
    "./navigation-menu": "./src/components/ui/navigation-menu.tsx",
    "./pagination": "./src/components/ui/pagination.tsx",
    "./popover": "./src/components/ui/popover.tsx",
    "./scroll-area": "./src/components/ui/scroll-area.tsx",
    "./select": "./src/components/ui/select.tsx",
    "./separator": "./src/components/ui/separator.tsx",
    "./skeleton": "./src/components/ui/skeleton.tsx",
    "./spinner": "./src/components/ui/spinner.tsx",
    "./switch": "./src/components/ui/switch.tsx",
    "./textarea": "./src/components/ui/textarea.tsx",
    "./toast": "./src/components/ui/toast.tsx",
    "./toggle": "./src/components/ui/toggle.tsx",
    "./toggle-group": "./src/components/ui/toggle-group.tsx",
    "./tooltip": "./src/components/ui/tooltip.tsx",
    "./logo": "./src/components/logo.tsx",
    "./icon/github": "./src/components/icon/github.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@pindou/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "culori": "^4.0.2",
    "lucide-react": "^1.27.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.8.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}