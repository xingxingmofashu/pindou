# Pindou environment variables — copy to `.env` and fill in real values.
# `.env` is gitignored; only this `.env.example` is committed.

# Neon Postgres connection string (Drizzle + serverless pool).
DATABASE_URL=

# Public site origin used for canonical/OG/sitemap URLs (no trailing slash).
# Falls back to BETTER_AUTH_URL when unset.
NEXT_PUBLIC_SITE_URL=

# Better Auth (GitHub OAuth) — the deployed origin (no trailing slash).
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Upstash Redis — distributed rate limiting for /api/transform (and any future
# mutating endpoints). Shared across all serverless instances and platforms.
# Create a free database at https://console.upstash.com (Vercel KV works too).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 — pattern-grid JSON + thumbnail storage. Hard dependency of
# publishing/editing AND pattern-detail reads (grids are not in Postgres).
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL of the R2 bucket (thumbnail images are served from here).
NEXT_R2_PUBLIC_URL=
